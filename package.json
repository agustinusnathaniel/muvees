{
  "name": "muvees",
  "version": "1.3.5",
  "private": true,
  "author": "agustinusnathaniel",
  "engines": {
    "node": "^24.14.0"
  },
  "packageManager": "pnpm@11.7.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.16.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "next dev",
    "lint": "next lint",
    "turbo": "pnpm dlx turbo@2.6.3",
    "build": "next build",
    "build:turbo": "pnpm turbo build",
    "postbuild": "next-sitemap --config next-sitemap.config.js",
    "ultracite:check": "ultracite check --error-on-warnings",
    "ultracite:fix": "ultracite fix --error-on-warnings",
    "biome:ci": "biome ci",
    "start": "next start",
    "type:check": "tsc --noEmit",
    "check:turbo": "pnpm turbo ultracite:check type:check",
    "up-interactive": "pnpm up -i",
    "up-latest": "pnpm up-interactive -L",
    "release": "cross-env HUSKY=0 standard-version",
    "push-release": "git push --follow-tags origin main",
    "prepare": "husky"
  },
  "dependencies": {
    "@bprogress/next": "^3.2.12",
    "@chakra-ui/react": "^3.36.1",
    "@emotion/react": "^11.14.0",
    "better-all": "^0.0.7",
    "framer-motion": "^12.42.2",
    "ky": "^2.0.2",
    "lodash": "^4.18.1",
    "next": "^16.3.0",
    "next-seo": "^7.2.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.7.0",
    "swr": "^2.4.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/cz-commitlint": "^21.2.0",
    "@types/lodash": "^4.17.24",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "commitizen": "^4.3.2",
    "commitlint": "^21.2.1",
    "cross-env": "^10.1.0",
    "husky": "^9.1.7",
    "knip": "^6.27.0",
    "lint-staged": "^17.1.0",
    "next-sitemap": "^4.2.3",
    "standard-version": "^9.5.0",
    "typescript": "^7.0.2",
    "ultracite": "7.9.4"
  }
}
